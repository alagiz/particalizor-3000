{
  "name": "particalizor-3000",
  "version": "1.2.2",
  "description": "react library capable of particalizing images; particalize your image right away!",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/assets/*\" lib",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "image",
    "particles",
    "particalize",
    "particalize image",
    "particalizing images"
  ],
  "author": "alagiz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alagiz/particalizor-3000.git"
  },
  "bugs": {
    "url": "https://github.com/alagiz/particalizor-3000/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "ramda": "^0.30.1",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/ramda": "^0.30.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "copyfiles": "^2.4.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
